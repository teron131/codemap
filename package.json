{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "codemap",
  "version": "0.11.0",
  "private": true,
  "description": "Opinionated Codebase Memory, rg, and ast-grep source inspection CLI.",
  "type": "module",
  "bin": {
    "codemap": "./dist/codemap/cli.js"
  },
  "files": [
    "dist/codemap"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/codemap/cli.js",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test",
    "clean": "rm -rf dist",
    "dev": "tsx src/codemap/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --dir test --exclude 'test/.work/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/napi": "^0.45.2",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.1"
}
